{
  "name": "bus-booking-system",
  "version": "1.0.0",
  "description": "Full-Stack Bus Booking Management System (MERN)",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "node backend/src/server.js",
    "build": "cd frontend && npm install && npm run build && cd ../backend && npm install",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend test",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "author": "Ayan Anwar",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
